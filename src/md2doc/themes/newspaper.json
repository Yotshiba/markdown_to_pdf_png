{
  "id": "newspaper",
  "name": "Newspaper",
  "mode": "light",
  "colors": {
    "page_bg": "#fbfaf6",
    "text": "#1c1c1c",
    "text_muted": "#555555",
    "heading": "#000000",
    "link": "#8b1a1a",
    "accent": "#8b1a1a",
    "border": "#1c1c1c",
    "code_bg": "#efede6",
    "code_fg": "#1c1c1c",
    "inline_code_bg": "#e9e6dd",
    "quote_bar": "#8b1a1a",
    "quote_bg": "#fbfaf6",
    "table_head_bg": "#efede6",
    "table_stripe": "#f5f3ec",
    "selection": "#e6d3b8",
    "admonition": {
      "note": {
        "bar": "#2a4d7a",
        "bg": "#e9ebec",
        "title": "#2a4d7a"
      },
      "tip": {
        "bar": "#2f6b3a",
        "bg": "#eaeee6",
        "title": "#2f6b3a"
      },
      "important": {
        "bar": "#6a3a7a",
        "bg": "#efeaec",
        "title": "#6a3a7a"
      },
      "warning": {
        "bar": "#8a6000",
        "bg": "#f2ede4",
        "title": "#8a6000"
      },
      "caution": {
        "bar": "#8b1a1a",
        "bg": "#f4e8e3",
        "title": "#8b1a1a"
      }
    }
  },
  "fonts": {
    "body": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif",
    "heading": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif",
    "mono": "\"JetBrains Mono\", \"Cascadia Mono\", Consolas, monospace",
    "size_pt": 10,
    "line_height": 1.5,
    "heading_scale": 1.3,
    "heading_weight": 700
  },
  "layout": {
    "table_style": "grid",
    "page": {
      "columns": 2,
      "column_gap_mm": 9,
      "justify": true,
      "hyphenate": true,
      "margin_mm": [
        18,
        16,
        20,
        16
      ]
    }
  }
}